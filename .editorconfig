# EditorConfig helps maintain consistent coding styles across IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_size = 2
max_line_length = 120

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.yml]
indent_size = 2

[*.sh]
end_of_line = lf
indent_size = 2
