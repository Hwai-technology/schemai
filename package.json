{
  "name": "schema-ai",
  "displayName": "SchemAI - External Code & License Risk Analyzer",
  "description": "Smart extension to detect external code, search sources (GitHub), evaluate license compatibility, and assess risks on paste.",
  "version": "0.1.0",
  "publisher": "schemai-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hwai-technology/schemai"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SchemAI",
      "properties": {
        "schemaAI.projectLicense": {
          "type": "string",
          "default": "MIT",
          "description": "SPDX identifier of the project license used to evaluate external code compatibility."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run clean && npm run compile && mocha \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "mocha": "^10.8.2",
    "typescript": "^4.9.5"
  }
}
