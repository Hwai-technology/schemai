{
  "name": "schema-ai",
  "displayName": "SchemAI - External Code & License Risk Analyzer",
  "description": "Smart extension to detect external code, search sources (GitHub), evaluate license compatibility, and assess risks on paste.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "schemai-team",
  "icon": "media/schema_ai_team_logo.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hwai-technology/schemai"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:cpp",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "schemaAI.analyzeSelection",
        "title": "SchemAI: Analyze Selected Code"
      },
      {
        "command": "schemaAI.checkLastPasted",
        "title": "SchemAI: Check Last Pasted Code Risk"
      },
      {
        "command": "schemaAI.showAuditLog",
        "title": "SchemAI: View Paste & License History (Audit Log)"
      },
      {
        "command": "schemaAI.login",
        "title": "SchemAI: Sign in to GitHub"
      },
      {
        "command": "schemaAI.manageAccount",
        "title": "SchemAI: Manage GitHub Account"
      },
      {
        "command": "schemaAI.disconnect",
        "title": "SchemAI: Disconnect GitHub Account"
      },
      {
        "command": "schemaAI.clearHistory",
        "title": "SchemAI: Clear Audit History"
      },
      {
        "command": "schemaAI.markFalsePositive",
        "title": "SchemAI: Mark Alert as False Positive"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "schemaAI.analyzeSelection",
          "when": "editorHasSelection",
          "group": "1_modification@1"
        },
        {
          "command": "schemaAI.checkLastPasted",
          "when": "editorTextFocus",
          "group": "1_modification@2"
        },
        {
          "command": "schemaAI.showAuditLog",
          "when": "editorTextFocus",
          "group": "1_modification@3"
        }
      ],
      "view/item/context": [
        {
          "command": "schemaAI.markFalsePositive",
          "when": "view == schemaAI.auditHistoryView && viewItem == pasteAuditEntry",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "schema-ai-sidebar",
          "title": "SchemAI",
          "icon": "media/schema_ai_team_logo.jpg"
        }
      ]
    },
    "views": {
      "schema-ai-sidebar": [
        {
          "id": "schemaAI.auditHistoryView",
          "name": "Paste & Risk Tracker"
        }
      ]
    },
    "configuration": {
      "title": "SchemAI Settings",
      "properties": {
        "schemaAI.projectLicense": {
          "type": "string",
          "default": "MIT",
          "description": "The target license of your project for compatibility checking."
        },
        "schemaAI.githubToken": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Deprecated. Sign in with GitHub or store secrets via SchemAI SecretStorage.",
          "description": "Optional legacy GitHub Personal Access Token."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile && mocha out/test/**/*.test.js",
    "package": "vsce package --allow-missing-repository",
    "release": "powershell -ExecutionPolicy Bypass -File release.ps1",
    "release:minor": "powershell -ExecutionPolicy Bypass -File release.ps1 -ReleaseType minor",
    "release:major": "powershell -ExecutionPolicy Bypass -File release.ps1 -ReleaseType major"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.0.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.2.0",
    "typescript": "^4.9.5"
  }
}
