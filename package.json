{
  "name": "schema-ai",
  "displayName": "SchemAI - External Code & License Risk Analyzer",
  "description": "Smart extension to detect external code, search sources (GitHub), evaluate license compatibility, and assess risks on paste.",
  "version": "3.0.4",
  "publisher": "schemai-team",
  "license": "MIT",
  "icon": "media/schema_ai_team_logo.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hwai-technology/schemai"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SchemAI",
      "properties": {
        "schemaAI.projectLicense": {
          "type": "string",
          "default": "MIT",
          "description": "SPDX identifier of the project license used to evaluate external code compatibility."
        },
        "schemaAI.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze code pasted into the editor. Disable to only analyze on demand."
        },
        "schemaAI.githubToken": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Deprecated. Sign in with GitHub or store secrets via SchemAI SecretStorage.",
          "description": "Optional legacy GitHub Personal Access Token."
        },
        "schemaAI.llmProvider": {
          "type": "string",
          "enum": [
            "local",
            "openai",
            "custom"
          ],
          "default": "local",
          "description": "AI provider for generating license risk explanations: Local LLM (Ollama, LM Studio) or Cloud API (OpenAI, Custom)."
        },
        "schemaAI.llmEndpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1/chat/completions",
          "description": "API endpoint for LLM explanations (e.g., http://localhost:11434/v1/chat/completions for local Ollama, or https://api.openai.com/v1/chat/completions for OpenAI)."
        },
        "schemaAI.llmModel": {
          "type": "string",
          "default": "llama3",
          "description": "Model name for AI license explanations (e.g., llama3, mistral, gpt-4o-mini)."
        },
        "schemaAI.llmLocale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "default": "auto",
          "description": "Language used for generating AI license explanations."
        }
      }
    },
    "commands": [
      {
        "command": "schemaAI.analyzeSelection",
        "title": "Analyze Selection",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.analyzeFile",
        "title": "Analyze File",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.checkLastPasted",
        "title": "Check Last Pasted Code Risk",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.showAuditLog",
        "title": "View Paste & License History (Audit Log)",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.login",
        "title": "Sign in to GitHub",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.manageAccount",
        "title": "Manage GitHub Account",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.disconnect",
        "title": "Sign out of GitHub",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.clearHistory",
        "title": "Clear Audit History",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.markFalsePositive",
        "title": "Mark Alert as False Positive",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.explainRiskWithAI",
        "title": "Generate AI License Explanation",
        "category": "SchemAI"
      },
      {
        "command": "schemaAI.switchLLMProvider",
        "title": "Switch AI Provider (Local / Cloud API)",
        "category": "SchemAI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "schemaAI.analyzeSelection",
          "when": "editorHasSelection",
          "group": "schemaAI@1"
        },
        {
          "command": "schemaAI.analyzeFile",
          "when": "editorTextFocus",
          "group": "schemaAI@2"
        },
        {
          "command": "schemaAI.checkLastPasted",
          "when": "editorTextFocus",
          "group": "schemaAI@3"
        },
        {
          "command": "schemaAI.explainRiskWithAI",
          "when": "editorTextFocus",
          "group": "schemaAI@4"
        },
        {
          "command": "schemaAI.showAuditLog",
          "when": "editorTextFocus",
          "group": "schemaAI@5"
        }
      ],
      "explorer/context": [
        {
          "command": "schemaAI.analyzeFile",
          "when": "!explorerResourceIsFolder",
          "group": "schemaAI@1"
        }
      ],
      "commandPalette": [
        {
          "command": "schemaAI.analyzeSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "schemaAI.analyzeFile"
        },
        {
          "command": "schemaAI.checkLastPasted"
        },
        {
          "command": "schemaAI.showAuditLog"
        },
        {
          "command": "schemaAI.login"
        },
        {
          "command": "schemaAI.disconnect"
        },
        {
          "command": "schemaAI.clearHistory"
        },
        {
          "command": "schemaAI.explainRiskWithAI"
        },
        {
          "command": "schemaAI.switchLLMProvider"
        }
      ],
      "view/item/context": [
        {
          "command": "schemaAI.markFalsePositive",
          "when": "view == schemaAI.auditHistoryView && viewItem == pasteAuditEntry",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "schema-ai-sidebar",
          "title": "SchemAI",
          "icon": "media/schema_ai_icon.svg"
        }
      ]
    },
    "views": {
      "schema-ai-sidebar": [
        {
          "type": "webview",
          "id": "schemaAI.sidebarView",
          "name": "SchemAI Dashboard"
        },
        {
          "id": "schemaAI.auditHistoryView",
          "name": "Paste & Risk Tracker"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run clean && npm run compile && mocha \"out/test/**/*.test.js\"",
    "package": "vsce package --allow-missing-repository",
    "release": "./release.sh minor",
    "release:patch": "./release.sh patch",
    "release:major": "./release.sh major"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.15.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.2.0",
    "typescript": "^4.9.5"
  }
}
